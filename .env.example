# ───────────────────────── QUILL GUARD environment ─────────────────────────
# Copy to `.env` and fill in. Never commit the real .env.

NODE_ENV=development
LOG_LEVEL=info

# Discord application (https://discord.com/developers/applications)
# Bot → Privileged Gateway Intents: enable SERVER MEMBERS and MESSAGE CONTENT.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# OAuth2 client secret — needed by the worker (member backups) and the website.
DISCORD_CLIENT_SECRET=

# PostgreSQL (any host: docker-compose, Neon, Supabase, Railway, Render, VPS…)
# Managed hosts usually need `?sslmode=require`.
DATABASE_URL=postgres://quill:quill@localhost:5432/quill
DB_POOL_MAX=5
AUTO_MIGRATE=true

# Redis — required for sharding, the worker and the website. Optional for single-process dev.
REDIS_URL=redis://localhost:6379

# 32 random bytes, base64. Encrypts OAuth tokens and bring-your-own AI keys.
#   openssl rand -base64 32
ENCRYPTION_KEY=
# Shared with the website: signs verification links. At least 32 characters.
#   openssl rand -base64 48
VERIFY_TOKEN_SECRET=
# Website only (used to hash IPs, never store raw IPs). Keep it secret and stable.
HASH_PEPPER=

# Public URLs
WEBSITE_URL=http://localhost:3000
# Optional: public PNG/WebP of the QUILL logo for card thumbnails (defaults to the bot avatar).
BRAND_LOGO_URL=
SUPPORT_SERVER_URL=

# Development: register commands instantly in this guild (`pnpm commands:deploy --dev`).
DEV_GUILD_ID=
# `auto` (recommended) or a fixed number of shards.
SHARD_COUNT=auto
