    "./antinuke": "./src/antinuke/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "wordlist:validate": "tsx scripts/validate-wordlists.ts"
  },
  "dependencies": {
    "@quill/shared": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "an-array-of-english-words": "2.0.0"
  }
}
