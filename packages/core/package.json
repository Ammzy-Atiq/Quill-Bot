{
  "name": "@quill/core",
  "version": "0.1.0",
  "private": true,
  "description": "QUILL GUARD core engine (framework-free): normalizer, word lists, detectors, risk engine, anti-nuke & anti-raid scoring, verification matcher.",
  "author": "Atiq Ur Rahman",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
