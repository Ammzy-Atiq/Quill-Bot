{
  "name": "@quill/bot",
  "version": "0.1.0",
  "private": true,
  "description": "QUILL GUARD Discord bot — AutoMod, Verification & Anti-Nuke. Made by Atiq Ur Rahman.",
  "author": "Atiq Ur Rahman",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/shard.ts",
    "dev:worker": "tsx watch --clear-screen=false src/worker.ts",
    "start": "node dist/index.js",
    "start:shard": "node dist/shard.js",
    "start:worker": "node dist/worker.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "commands:deploy": "tsx scripts/deploy-commands.ts",
    "commands:manifest": "tsx scripts/export-manifest.ts",
    "check:boot": "tsx src/shard.ts --dry-run",
    "verify:link": "tsx scripts/verify-link.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@quill/core": "workspace:*",
    "@quill/db": "workspace:*",
    "@quill/shared": "workspace:*",
    "bullmq": "6.3.9",
    "discord.js": "14.27.0",
    "drizzle-orm": "0.45.3",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15"
  },
  "optionalDependencies": {
    "sharp": "0.34.5"
  }
}
